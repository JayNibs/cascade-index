<script>
const ARMS=[["C","Capability","var(--cap)"],["E","Exposure","var(--exp)"],["K","Control (higher = weaker)","var(--ctl)"],["P","Pressure","var(--prs)"]];
const ROOTS={C1:"Frontier task horizon",C2:"Benchmark trajectory",C3:"Cost per unit capability",C4:"Autonomy in deployment",
 E1:"Breadth of dependence",E2:"Agentic deployment share",E3:"Access diffusion",E4:"Physical coupling / incidents",
 K1:"Alignment reliability",K2:"Detection / interpretability",K3:"Intervention capacity",K4:"Governance in force",
 P1:"Race intensity",P2:"Compute buildout",P3:"State and military deployment",P4:"Attacker / defender asymmetry"};
const IDS=Object.keys(ROOTS);
const FILE="the-bad/data.json";
const $=id=>document.getElementById(id);
const msg=(t,cls)=>{const m=$("msg");m.hidden=false;m.className="msg "+(cls||"");m.innerHTML=t};

const KEY="the-bad-publish-settings", OLDKEY="dci-publish-settings";
function loadSetup(){try{return JSON.parse(localStorage.getItem(KEY)||localStorage.getItem(OLDKEY)||"{}")}catch(e){return{}}}
function showSetup(){
  const s=loadSetup();
  $("ghOwner").value=s.owner||""; $("ghRepo").value=s.repo||""; $("ghBranch").value=s.branch||"main"; $("ghToken").value=s.token||"";
  const ok=s.owner&&s.repo&&s.token;
  $("setupState").textContent=ok?"Saved. Publishing goes to "+s.owner+"/"+s.repo+"/"+FILE+".":"Not set up yet. You can still use Download.";
  $("setup").open=!ok;
}
$("saveSetup").onclick=()=>{localStorage.setItem(KEY,JSON.stringify({owner:$("ghOwner").value.trim(),repo:$("ghRepo").value.trim(),branch:$("ghBranch").value.trim()||"main",token:$("ghToken").value.trim()}));showSetup()};
$("clearSetup").onclick=()=>{localStorage.removeItem(KEY);showSetup()};
showSetup();

let DATA=null; const els={};
const box=$("roots");
ARMS.forEach(([k,name,css])=>{
  const h=document.createElement("h3"); h.innerHTML='<i style="background:'+css+'"></i>'+name; box.appendChild(h);
  [1,2,3,4].forEach(i=>{
    const id=k+i, d=document.createElement("div"); d.className="vec";
    d.innerHTML='<div class="nm">'+ROOTS[id]+'<small>'+id+'</small><div class="prev" id="prev'+id+'"></div></div>'+
      '<div class="sc"><label for="s'+id+'">Score</label><input id="s'+id+'" type="number" min="0" max="100" step="1" required></div>'+
      '<div class="nt"><label for="n'+id+'">Note</label><textarea id="n'+id+'" rows="1"></textarea></div>';
    box.appendChild(d); els[id]={score:$("s"+id),note:$("n"+id),prev:$("prev"+id)};
  });
});
const mean=a=>a.reduce((x,y)=>x+y,0)/a.length;
function readRoots(){const r={};IDS.forEach(id=>{r[id]=els[id].score.value===""?NaN:Number(els[id].score.value)});return r}
function preview(){
  const r=readRoots(); const bad=IDS.some(id=>!Number.isInteger(r[id])||r[id]<0||r[id]>100);
  if(bad){["pC","pE","pK","pP","pI"].forEach(x=>$(x).textContent="—");return}
  const c={};ARMS.forEach(([k])=>{c[k]=Math.round(mean([1,2,3,4].map(i=>r[k+i])))});
  $("pC").textContent=c.C;$("pE").textContent=c.E;$("pK").textContent=c.K;$("pP").textContent=c.P;
  $("pI").textContent=Math.round(c.C*c.E*c.P/Math.max(c.K,1)/100);
}
document.addEventListener("input",preview);
function addDays(iso,n){const d=new Date(iso+"T00:00:00");d.setDate(d.getDate()+n);return d.toISOString().slice(0,10)}
async function loadData(){
  try{const r=await fetch("data.json?v="+Date.now(),{cache:"no-store"});if(!r.ok)throw new Error(r.status);DATA=await r.json()}
  catch(e){DATA=null;msg("Could not read the current data.json from this site, so this page cannot pre-fill last week. Open it from the published site address.","warn");return}
  const last=DATA.weeks[DATA.weeks.length-1];
  if(last){$("date").value=addDays(last.date,7);IDS.forEach(id=>{els[id].score.value=last.roots[id];els[id].prev.textContent="last week "+last.roots[id]})}
  preview();
}
function applyProposal(p,from){
  if(!(p&&typeof p.date==="string"&&p.roots&&IDS.every(id=>Number.isInteger(p.roots[id])))) return {err:"That does not look like a proposal. It needs a date, all sixteen root scores, and notes."};
  if(DATA&&DATA.weeks.some(w=>w.date===p.date)){msg("The week of "+p.date+" is already published. Paste a newer proposal, or edit the form and publish to replace it.","warn");return {}}
  $("date").value=p.date;
  IDS.forEach(id=>{els[id].score.value=p.roots[id];els[id].note.value=(p.notes&&p.notes[id])||""});
  preview(); msg("Filled in from "+from+" for the week of "+p.date+". Check it, change anything you disagree with, then publish.","ok"); return {};
}
$("applyProposal").onclick=()=>{
  let raw=$("proposal").value.trim(); const a=raw.indexOf("{"),z=raw.lastIndexOf("}");
  if(a<0||z<0){msg("Paste the whole block, starting with { and ending with }.","err");return}
  let p;try{p=JSON.parse(raw.slice(a,z+1))}catch(e){msg("Could not read that block. Copy it again from the scoring message, all of it.","err");return}
  const r=applyProposal(p,"the pasted proposal"); if(r.err)msg(r.err,"err"); else $("proposalBox").open=false;
};
loadData();
function collect(){
  const date=$("date").value, r=readRoots();
  if(!/^\d{4}-\d{2}-\d{2}$/.test(date)) return {err:"Enter the week's date."};
  const bad=IDS.find(id=>!Number.isInteger(r[id])||r[id]<0||r[id]>100);
  if(bad) return {err:"Score for "+bad+" must be a whole number from 0 to 100."};
  const notes={};IDS.forEach(id=>{const t=els[id].note.value.trim();if(t)notes[id]=t});
  return {week:{date,roots:r,notes}};
}
function merged(week){
  const d=DATA?JSON.parse(JSON.stringify(DATA)):{weeks:[]};
  const i=d.weeks.findIndex(w=>w.date===week.date);
  if(i>=0){if(!confirm("A week dated "+week.date+" already exists. Replace it?"))return null;d.weeks[i]=week}else d.weeks.push(week);
  d.weeks.sort((a,b)=>a.date<b.date?-1:a.date>b.date?1:0); return d;
}
const b64=s=>btoa(unescape(encodeURIComponent(s))), unb64=s=>decodeURIComponent(escape(atob(s.replace(/\n/g,""))));
$("publish").onclick=async()=>{
  const s=loadSetup();
  if(!(s.owner&&s.repo&&s.token)){$("setup").open=true;msg("Fill in the publishing settings first, or use Download instead.","warn");return}
  const c=collect();if(c.err){msg(c.err,"err");return}
  const btn=$("publish");btn.disabled=true;msg("Publishing…");
  try{
    const api="https://api.github.com/repos/"+s.owner+"/"+s.repo+"/contents/"+FILE;
    const hdr={"Authorization":"Bearer "+s.token,"Accept":"application/vnd.github+json","X-GitHub-Api-Version":"2022-11-28"};
    const g=await fetch(api+"?ref="+encodeURIComponent(s.branch),{headers:hdr});
    if(!g.ok) throw new Error(g.status===401||g.status===403?"GitHub rejected the token (check it has Contents read and write on this repository).":g.status===404?"GitHub could not find "+FILE+" in "+s.owner+"/"+s.repo+".":"GitHub error "+g.status);
    const cur=await g.json(); DATA=JSON.parse(unb64(cur.content));
    const next=merged(c.week);if(!next){btn.disabled=false;msg("Cancelled.");return}
    const p=await fetch(api,{method:"PUT",headers:{...hdr,"Content-Type":"application/json"},body:JSON.stringify({message:"The Bad: add week of "+c.week.date,branch:s.branch,sha:cur.sha,content:b64(JSON.stringify(next,null,1)+"\n")})});
    if(!p.ok){const t=await p.text();throw new Error("GitHub would not save the file ("+p.status+"). "+t.slice(0,200))}
    DATA=next; msg("Published week of "+c.week.date+". The public page updates within about a minute.","ok");
  }catch(e){msg(String(e.message||e),"err")}
  btn.disabled=false;
};
$("download").onclick=()=>{
  const c=collect();if(c.err){msg(c.err,"err");return}
  const next=merged(c.week);if(!next)return;
  const blob=new Blob([JSON.stringify(next,null,1)+"\n"],{type:"application/json"});
  const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="data.json";a.click();
  msg("Downloaded data.json with the week of "+c.week.date+" added. Upload it to the-bad/ in the repo to publish.","ok");
};
</script>
