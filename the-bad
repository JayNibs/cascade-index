<body>
<canvas id="scene"></canvas>

<div class="hud" id="top">
  <h1>The Bad<small>AI catastrophic-risk trend model · sixteen roots, four arms, one destination</small></h1>
  <div class="comps" id="comps"></div>
</div>

<div id="info"><button class="x" id="infoX" aria-label="close">×</button><div class="id"></div><div class="nm"></div><div class="sc"></div><div class="note"></div></div>

