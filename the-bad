  <p id="hint">Drag to rotate · pinch or scroll to zoom · tap a vine for its root · tap the box at the top for the catastrophes</p>
</div>
<div id="err">Data could not be loaded.</div>

<div id="bad"><div class="card"><button class="x" id="badX">Close</button><h2>The bad</h2><p class="sub">Four paths, each a set of preconditions that must all be met at once. Weakest link is what has to move; geometric mean penalizes any precondition far from met. Neither is a probability.</p><div id="paths"></div></div></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/examples/js/controls/OrbitControls.js"></script>
<script>
// ---------- model ----------
const ARMS=[
  {key:"C",name:"Capability",color:0x4FB3A6,css:"var(--cap)",dir:[0,1]},
  {key:"E",name:"Exposure",color:0x5B8DEF,css:"var(--exp)",dir:[1,0]},
  {key:"K",name:"Control",color:0xE0A126,css:"var(--ctl)",dir:[0,-1]},
  {key:"P",name:"Pressure",color:0xD9483B,css:"var(--prs)",dir:[-1,0]},
];
const ROOTS={
  C1:"Frontier task horizon",C2:"Benchmark trajectory",C3:"Cost per unit capability",C4:"Autonomy in deployment",
  E1:"Breadth of dependence",E2:"Agentic deployment share",E3:"Access diffusion",E4:"Physical coupling / incidents",
  K1:"Alignment reliability",K2:"Detection / interpretability",K3:"Intervention capacity",K4:"Governance in force",
  P1:"Race intensity",P2:"Compute buildout",P3:"State and military deployment",P4:"Attacker / defender asymmetry",
};
const PATHS=[
  {name:"Misuse",sub:"cyber · bio · infrastructure",pre:{"threshold":["C1","C2"],"access":["E3"],"safeguards weak":["K3"],"execution path":["E4"],"defenders behind":["P4"]},
   list:["Engineered pandemic from AI-assisted biodesign","Grid, water or pipeline control-system sabotage","Financial-system breach or settlement-rail compromise","Mass autonomous cybercrime overwhelming response capacity"]},
  {name:"Loss of control",sub:"misaligned or rogue system",pre:{"threshold":["C1","C2"],"autonomy":["C4","E2"],"misalignment":["K1"],"detection failing":["K2"],"no kill switch":["K3"]},
   list:["Rogue internal deployment that resists shutdown","Self-exfiltration of model weights to uncontrolled compute","Covert sabotage of safety research or successor training","Deceptive alignment that survives evaluation and deploys at scale"]},
  {name:"Systemic",sub:"economic · infrastructural",pre:{"dependence":["E1"],"correlated failure":["E2","P2"],"speed":["C4","E4"],"no circuit breaker":["K4"]},
   list:["Correlated failure across a shared base model or provider","Flash-crash cascade through agent-driven markets","Labor-displacement shock faster than institutions absorb","Capex collapse propagating through the AI supply chain"]},
  {name:"Arms race",sub:"state escalation",pre:{"decision loops":["P3"],"compressed timelines":["P1"],"miscalculation":["P1","P2"],"veto absent":["K3","K4"]},
   list:["Automated escalation between AI-assisted command systems","Autonomous targeting error with mass casualties","Pre-emptive strike driven by a perceived capability gap","Compute or chip infrastructure as a kinetic target"]},
];
const mean=a=>a.reduce((x,y)=>x+y,0)/a.length;
function compute(week){
  const r=week.roots, comps={}, paths=[];
  ARMS.forEach(a=>{comps[a.key]=Math.round(mean([1,2,3,4].map(i=>r[a.key+i])))});
  PATHS.forEach(p=>{
    const pre=Object.entries(p.pre).map(([k,ids])=>[k,Math.round(mean(ids.map(i=>r[i])))]);
    const vals=pre.map(x=>x[1]), min=Math.min(...vals);
    const geo=Math.round(Math.exp(mean(vals.map(v=>Math.log(Math.max(v,1)/100))))*100);
    paths.push({name:p.name,sub:p.sub,list:p.list,pre,min,geo});
  });
  const idx=Math.round(comps.C*comps.E*comps.P/Math.max(comps.K,1)/100);
  return {comps,paths,idx,maxGeo:Math.max(...paths.map(p=>p.geo))};
}

// ---------- scene ----------
const canvas=document.getElementById("scene");
const renderer=new THREE.WebGLRenderer({canvas,antialias:true,alpha:false});
renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
renderer.setClearColor(0x0B0E13,1);
renderer.toneMapping=THREE.ACESFilmicToneMapping;
const scene=new THREE.Scene();
scene.fog=new THREE.FogExp2(0x0B0E13,0.035);
const camera=new THREE.PerspectiveCamera(42,1,0.1,200);
camera.position.set(13,8,17);
const controls=new THREE.OrbitControls(camera,canvas);
controls.target.set(0,4.4,0);
controls.enableDamping=true; controls.dampingFactor=0.06;
controls.minDistance=5; controls.maxDistance=40;
controls.maxPolarAngle=Math.PI*0.52;
controls.autoRotate=true; controls.autoRotateSpeed=0.45;
controls.addEventListener("start",()=>{controls.autoRotate=false});

scene.add(new THREE.HemisphereLight(0x3A4556,0x0B0E13,0.9));
const H=8.2;                                   // max vine height
const TOP=new THREE.Vector3(0,H+1.1,0);        // the light and the box
const sun=new THREE.PointLight(0xFFE2A8,1.4,40,1.6); sun.position.copy(TOP); scene.add(sun);
const keyL=new THREE.DirectionalLight(0xBFC8D6,0.35); keyL.position.set(6,10,4); scene.add(keyL);

// floor
const floor=new THREE.Mesh(new THREE.CircleGeometry(9,96),new THREE.MeshStandardMaterial({color:0x10141B,roughness:1,metalness:0}));
floor.rotation.x=-Math.PI/2; floor.position.y=-0.06; scene.add(floor);
const ring=new THREE.Mesh(new THREE.RingGeometry(5.6,5.64,128),new THREE.MeshBasicMaterial({color:0x2A313B,side:THREE.DoubleSide}));
ring.rotation.x=-Math.PI/2; ring.position.y=-0.05; scene.add(ring);

// cross
const ARM_LEN=5.4, SPOTS=[1.3,2.6,3.9,5.2];
const armMat=new THREE.MeshStandardMaterial({color:0xD8D3C6,roughness:0.75,metalness:0.05});
ARMS.forEach(a=>{
  const g=new THREE.BoxGeometry(ARM_LEN,0.08,0.42);
  const m=new THREE.Mesh(g,armMat);
  const [dx,dz]=a.dir;
  m.position.set(dx*ARM_LEN/2,0,dz*ARM_LEN/2);
  m.rotation.y=dz!==0?Math.PI/2:0;
  scene.add(m);
  // arm tip label
  const lab=textSprite(a.name.toUpperCase(),{size:34,color:"#"+a.color.toString(16).padStart(6,"0"),mono:false});
  lab.position.set(dx*(ARM_LEN+0.9),0.25,dz*(ARM_LEN+0.9)); lab.scale.multiplyScalar(0.55); scene.add(lab);
});
const hub=new THREE.Mesh(new THREE.CylinderGeometry(0.34,0.34,0.1,32),armMat); scene.add(hub);

// the bad: box + glow
const box=new THREE.Group(); box.position.copy(TOP); scene.add(box);
const boxCore=new THREE.Mesh(new THREE.BoxGeometry(1.1,1.1,1.1),new THREE.MeshStandardMaterial({color:0x0A0C10,roughness:0.4,metalness:0.2,emissive:0x3A2A10,emissiveIntensity:0.6,transparent:true,opacity:0.92}));
box.add(boxCore);
const boxEdges=new THREE.LineSegments(new THREE.EdgesGeometry(new THREE.BoxGeometry(1.14,1.14,1.14)),new THREE.LineBasicMaterial({color:0xFFE2A8,transparent:true,opacity:0.9}));
box.add(boxEdges);
const glowTex=radialTexture();
const glow=new THREE.Sprite(new THREE.SpriteMaterial({map:glowTex,color:0xFFE2A8,transparent:true,opacity:0.55,depthWrite:false,blending:THREE.AdditiveBlending}));
glow.scale.set(5,5,1); box.add(glow);
const badLab=textSprite("the bad",{size:40,color:"#FFE2A8",mono:true}); badLab.position.set(0,1.05,0); box.add(badLab);
// embers inside the box
const emberN=90, emberPos=new Float32Array(emberN*3), emberSeed=[];
for(let i=0;i<emberN;i++){emberSeed.push(Math.random()*Math.PI*2,Math.random(),Math.random())}
const embers=new THREE.Points(new THREE.BufferGeometry().setAttribute("position",new THREE.BufferAttribute(emberPos,3)),
  new THREE.PointsMaterial({color:0xFFC978,size:0.05,transparent:true,opacity:0.9,depthWrite:false,blending:THREE.AdditiveBlending}));
box.add(embers);

// vines
const VINES={};  // id -> {mesh, mat, base, arm, target:{...}, cur:{...}}
const SEG=96;
function vineCurve(base,score,seed){
  const s=score/100;
  const h=0.15+s*(H-0.15);
  const pull=Math.pow(s,1.35);                      // convergence toward the axis
  const tx=base.x*(1-pull*0.92), tz=base.z*(1-pull*0.92);
  const ty=Math.min(h,TOP.y-0.75);
  const p0=base.clone();
  const p1=new THREE.Vector3(base.x*1.08,h*0.42,base.z*1.08);
  const p2=new THREE.Vector3(tx*1.35+Math.sin(seed)*0.25,h*0.82,tz*1.35+Math.cos(seed)*0.25);
  const p3=new THREE.Vector3(tx,ty,tz);
  const bez=new THREE.CubicBezierCurve3(p0,p1,p2,p3);
  // add organic wobble
  const pts=[];
  for(let i=0;i<=SEG;i++){
    const t=i/SEG, p=bez.getPoint(t);
    const w=0.09*Math.sin(t*9+seed)*t*(1-t)*4;
    p.x+=w*Math.cos(seed*2+t*5); p.z+=w*Math.sin(seed*2+t*5);
    pts.push(p);
  }
  return new THREE.CatmullRomCurve3(pts);
}
function buildVine(id,arm,base,seed){
  const mat=new THREE.MeshStandardMaterial({color:arm.color,roughness:0.55,metalness:0.1,emissive:arm.color,emissiveIntensity:0.12});
  const mesh=new THREE.Mesh(new THREE.TubeGeometry(vineCurve(base,1,seed),SEG,0.07,8,false),mat);
  mesh.userData.id=id; scene.add(mesh);
  const bud=new THREE.Mesh(new THREE.SphereGeometry(0.11,12,12),new THREE.MeshStandardMaterial({color:arm.color,emissive:arm.color,emissiveIntensity:0.6}));
  scene.add(bud);
  const base_=new THREE.Mesh(new THREE.CylinderGeometry(0.16,0.16,0.06,20),new THREE.MeshStandardMaterial({color:arm.color,roughness:0.6}));
  base_.position.copy(base); base_.position.y=0.07; scene.add(base_);
  const lab=textSprite(id,{size:26,color:"#9AA3AE",mono:true}); lab.position.set(base.x,0.4,base.z); lab.scale.multiplyScalar(0.55); scene.add(lab);
  mesh.geometry.setDrawRange(0,0); bud.visible=false;
  VINES[id]={mesh,mat,bud,base,arm,seed,score:0,grow:0,ready:false,curve:null};
}
ARMS.forEach(a=>{
  const [dx,dz]=a.dir;
  SPOTS.forEach((r,i)=>{
    const id=a.key+(i+1);
    buildVine(id,a,new THREE.Vector3(dx*r,0.07,dz*r),(i+1)*1.7+ARMS.indexOf(a)*0.9);
  });
});
function setVine(v,score){
  v.score=score;
  const curve=vineCurve(v.base,score,v.seed);
  v.mesh.geometry.dispose();
  v.mesh.geometry=new THREE.TubeGeometry(curve,SEG,0.045+0.07*(score/100),8,false);
  v.curve=curve; v.ready=true; v.bud.visible=true;
  const s=score/100;
  v.mat.emissiveIntensity=0.1+0.5*s*s;
}

// ---------- helpers ----------
function textSprite(text,{size=32,color="#fff",mono=false}){
  const c=document.createElement("canvas"); const ctx=c.getContext("2d");
  const font=(size*2)+"px "+(mono?'"IBM Plex Mono",monospace':'"IBM Plex Sans",sans-serif');
  ctx.font=font; const w=Math.ceil(ctx.measureText(text).width)+40;
  c.width=w; c.height=size*2+24;
  ctx.font=font; ctx.fillStyle=color; ctx.textBaseline="middle"; ctx.fillText(text,20,c.height/2);
  const tex=new THREE.CanvasTexture(c); tex.minFilter=THREE.LinearFilter;
  const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:tex,transparent:true,depthWrite:false}));
  sp.scale.set(c.width/120,c.height/120,1); return sp;
}
function radialTexture(){
  const c=document.createElement("canvas"); c.width=c.height=256; const g=c.getContext("2d");
  const r=g.createRadialGradient(128,128,0,128,128,128); r.addColorStop(0,"rgba(255,226,168,1)"); r.addColorStop(0.35,"rgba(255,200,120,0.35)"); r.addColorStop(1,"rgba(255,200,120,0)");
  g.fillStyle=r; g.fillRect(0,0,256,256); return new THREE.CanvasTexture(c);
}

// ---------- data + ui ----------
let DATA=null, CUR=0, calc=null;
const $=id=>document.getElementById(id);
async function load(){
  try{
    const r=await fetch("data.json?v="+Date.now(),{cache:"no-store"});
    if(!r.ok) throw new Error(r.status);
    DATA=await r.json();
    DATA.weeks.sort((a,b)=>a.date<b.date?-1:1);
  }catch(e){ $("err").style.display="block"; return; }
  const sl=$("slider"); sl.max=DATA.weeks.length-1; sl.value=DATA.weeks.length-1;
  sl.oninput=()=>showWeek(Number(sl.value));
  showWeek(DATA.weeks.length-1,true);
}
function showWeek(i,first){
  CUR=i; const w=DATA.weeks[i]; calc=compute(w);
  $("date").innerHTML=w.date+(w.backcast?"<em>backcast</em>":"")+(i===DATA.weeks.length-1&&!w.backcast?"<em>latest</em>":"");
  Object.keys(VINES).forEach(id=>{
    const v=VINES[id]; const prev=v.score;
    setVine(v,w.roots[id]??0);
    v.grow=first?0:Math.min(1,prev/Math.max(v.score,1));   // regrow from where it was
  });
  // composites
  $("comps").innerHTML=ARMS.map(a=>'<div class="comp"><div class="lab"><i style="background:'+a.css+'"></i>'+a.name+'</div><div class="val">'+calc.comps[a.key]+'<span>/100</span></div></div>').join("")+
    '<div class="comp"><div class="lab"><i style="background:var(--light)"></i>Index</div><div class="val">'+calc.idx+'<span>C×E×P÷K</span></div></div>';
  // the box
  const g=calc.maxGeo/100;
  glow.material.opacity=0.25+0.6*g; glow.scale.setScalar(3.5+5*g);
  sun.intensity=0.9+1.6*g; boxCore.material.emissiveIntensity=0.3+1.2*g;
  // paths panel
  $("paths").innerHTML=calc.paths.map(p=>'<div class="path"><div class="hd"><b>'+p.name+' <span style="color:var(--ink-2);font-size:12px;font-weight:400">'+p.sub+'</span></b><div class="m">weakest <strong>'+p.min+'</strong> · geo mean <strong>'+p.geo+'</strong></div></div>'+
    '<div class="pre">'+p.pre.map(([k,v])=>'<span class="'+(v===p.min?"weak":"")+'">'+k+' '+v+'</span>').join("")+'</div><ul>'+p.list.map(x=>'<li>'+x+'</li>').join("")+'</ul></div>').join("");
  if(info.id) showInfo(info.id);
}

// picking
const ray=new THREE.Raycaster(); ray.params.Line={threshold:0.2};
const info={id:null};
function showInfo(id){
  const w=DATA.weeks[CUR], v=VINES[id], prev=CUR>0?DATA.weeks[CUR-1].roots[id]:null;
  info.id=id;
  const el=$("info"); el.classList.add("on");
  el.querySelector(".id").textContent=id+" · "+v.arm.name;
  el.querySelector(".nm").textContent=ROOTS[id];
  el.querySelector(".sc").innerHTML=w.roots[id]+'<span>/100'+(prev!==null?" · prev "+prev+(w.roots[id]-prev>=0?" (+"+(w.roots[id]-prev)+")":" ("+(w.roots[id]-prev)+")"):"")+'</span>';
  el.querySelector(".note").textContent=(w.notes&&w.notes[id])||"No note this week.";
}
$("infoX").onclick=()=>{info.id=null;$("info").classList.remove("on")};
$("badX").onclick=()=>$("bad").classList.remove("on");
$("bad").addEventListener("click",e=>{if(e.target===$("bad"))$("bad").classList.remove("on")});
let downAt=null;
canvas.addEventListener("pointerdown",e=>{downAt=[e.clientX,e.clientY]});
canvas.addEventListener("pointerup",e=>{
  if(!downAt||Math.hypot(e.clientX-downAt[0],e.clientY-downAt[1])>8){downAt=null;return}
  downAt=null;
  const r=canvas.getBoundingClientRect();
  const m=new THREE.Vector2(((e.clientX-r.left)/r.width)*2-1,-((e.clientY-r.top)/r.height)*2+1);
  ray.setFromCamera(m,camera);
  const hitBox=ray.intersectObject(boxCore,false);
  if(hitBox.length){$("bad").classList.add("on");return}
  const hits=ray.intersectObjects(Object.values(VINES).map(v=>v.mesh),false);
  if(hits.length) showInfo(hits[0].object.userData.id);
});

// ---------- loop ----------
function resize(){
  const w=window.innerWidth,h=window.innerHeight;
  renderer.setSize(w,h,false); camera.aspect=w/h; camera.updateProjectionMatrix();
  if(w<640){camera.position.set(17,9,22);controls.target.set(0,5.8,0)}
}
window.addEventListener("resize",resize); resize();
const clock=new THREE.Clock();
function frame(){
  const dt=Math.min(clock.getDelta(),0.05), t=clock.elapsedTime;
  Object.values(VINES).forEach(v=>{
    if(!v.ready) return;
    if(v.grow<1){
      v.grow=Math.min(1,v.grow+dt*0.55);
      const e=1-Math.pow(1-v.grow,2.2);
      const idx=v.mesh.geometry.index.count;
      v.mesh.geometry.setDrawRange(0,Math.floor(idx*e/6)*6);
      const p=v.curve.getPoint(e); v.bud.position.copy(p);
    }else{
      v.mesh.geometry.setDrawRange(0,Infinity);
      v.bud.position.copy(v.curve.getPoint(1));
    }
    v.bud.scale.setScalar(0.9+0.25*Math.sin(t*2.2+v.seed));
  });
  // embers
  const pos=embers.geometry.attributes.position.array;
  for(let i=0;i<emberN;i++){
    const a=emberSeed[i*3]+t*0.35, r=0.15+emberSeed[i*3+1]*0.35, y=((emberSeed[i*3+2]+t*0.08)%1)*0.9-0.45;
    pos[i*3]=Math.cos(a)*r; pos[i*3+1]=y; pos[i*3+2]=Math.sin(a)*r;
  }
  embers.geometry.attributes.position.needsUpdate=true;
  box.rotation.y=t*0.12;
  glow.material.opacity=(glow.material.opacity)*(0.985)+ (0.25+0.6*(calc?calc.maxGeo/100:0.3)+0.06*Math.sin(t*1.7))*0.015;
  controls.update();
  renderer.render(scene,camera);
  requestAnimationFrame(frame);
}
frame();
load();
</script>
</body>
